# ============================================================
# SSEB AI Surat Generator — contoh konfigurasi lingkungan
# Salin menjadi backend/.env lalu isi nilainya. JANGAN commit .env.
# ============================================================

# ── Autentikasi Basic HTTP (WAJIB di produksi — server menolak start bila
#    AUTH_REQUIRE=1 dan kredensial kosong) ──
AUTH_USERNAME=
AUTH_PASSWORD=
# 1 = fail-closed (default). Set 0 HANYA untuk pengembangan lokal.
AUTH_REQUIRE=1

# ── Direktori (opsional; default diturunkan dari lokasi proyek) ──
# PROJECT_ROOT=
# OUTPUT_DIR=

# ── Render PDF ──
# Path binary wkhtmltopdf; kosong = pakai dari PATH sistem.
WKHTMLTOPDF_PATH=

# ── Ollama / LLM ──
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_NUM_PREDICT=1500
CONTEXT_BUDGET_RATIO=0.75

# ── RAG ──
RAG_ENABLED=1
RAG_TOP_K=4
MAX_RAG_CONTEXT_TOKENS=1800
# RAG_INDEX_CACHE=

# ── Telegram Bot (kosong = bot dinonaktifkan) ──
TELEGRAM_BOT_TOKEN=

# ── CORS — daftar origin yang diizinkan, pisahkan dengan koma.
#    Wildcard (*) + credentials DILARANG. ──
CORS_ALLOW_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
