# ══════════════════════════════════════════════════════════════════════════════
# SSEB-AI — Konfigurasi Environment (.env)
# Salin file ini menjadi .env dan sesuaikan nilainya.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8001

# ── Ollama LLM ───────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_NUM_PREDICT=1024

# ── RAG (Retrieval-Augmented Generation) ─────────────────────────────────────
RAG_ENABLED=true
RAG_TOP_K=3
MAX_RAG_CONTEXT_TOKENS=2000
CONTEXT_BUDGET_RATIO=0.6

# ── PDF Generator (wkhtmltopdf) ──────────────────────────────────────────────
# Sesuaikan path dengan lokasi instalasi wkhtmltopdf di sistem Anda
WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe

# ── HTTP Basic Auth (opsional) ───────────────────────────────────────────────
# Jika KEDUA variabel diisi, seluruh endpoint API dilindungi Basic Auth.
# Kosongkan keduanya untuk mode tanpa autentikasi.
AUTH_USERNAME=
AUTH_PASSWORD=

# ── Telegram Bot (opsional) ──────────────────────────────────────────────────
# Dapatkan token dari @BotFather di Telegram.
# Kosongkan jika tidak menggunakan fitur Bot Telegram.
TELEGRAM_BOT_TOKEN=
